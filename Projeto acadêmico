
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Portfólio profissional de Vitoria, estudante de Sistemas de Informação." />
    <title>Portfólio | Vitoria</title>
    <style>
      :root {
        --ink: #17202a;
        --muted: #5e6872;
        --canvas: #f7f6f3;
        --surface: #ffffff;
        --line: #e8e4de;
        --accent: #9c4f46;
        --accent-dark: #7e3d37;
        --accent-soft: #f9e8e3;
        --teal: #26726c;
        --shadow: 0 14px 38px rgba(35, 30, 25, 0.08);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        color: var(--ink);
        background: var(--canvas);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
      }

      a { color: inherit; }
      .container { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
      .eyebrow { margin: 0 0 12px; color: var(--accent); font-size: .76rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
      .section { padding: 88px 0; }
      .section-title { max-width: 680px; margin: 0 0 10px; font-size: clamp(1.8rem, 3vw, 2.55rem); line-height: 1.14; letter-spacing: -.045em; }
      .section-intro { max-width: 680px; margin: 0; color: var(--muted); }

      header {
        position: sticky;
        top: 0;
        z-index: 5;
        border-bottom: 1px solid rgba(232, 228, 222, .8);
        background: rgba(247, 246, 243, .88);
        backdrop-filter: blur(14px);
      }

      nav {
        min-height: 68px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        color: var(--ink);
        font-weight: 800;
        letter-spacing: -.03em;
        text-decoration: none;
      }

      .nav-links {
        display: flex;
        gap: 20px;
        padding: 0;
        margin: 0;
        list-style: none;
      }

      .nav-links a {
        color: var(--muted);
        font-size: .9rem;
        font-weight: 650;
        text-decoration: none;
      }

      .nav-links a:hover { color: var(--accent); }

      .hero {
        overflow: hidden;
        padding: 100px 0 82px;
        background:
          radial-gradient(circle at 85% 15%, #ead7d0 0, transparent 24rem),
          linear-gradient(135deg, #fffdf9 0%, #f6f1ec 100%);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
        align-items: center;
        gap: 70px;
      }

      .hero h1 {
        max-width: 760px;
        margin: 0;
        font-size: clamp(2.7rem, 6vw, 5.4rem);
        line-height: .98;
        letter-spacing: -.07em;
      }

      .hero h1 span { color: var(--accent); }

      .hero-copy {
        max-width: 640px;
        margin: 28px 0 0;
        color: #47515b;
        font-size: 1.08rem;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 32px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 18px;
        border: 1px solid var(--accent);
        border-radius: 100px;
        background: var(--accent);
        color: white;
        font-weight: 750;
        text-decoration: none;
        transition: transform .2s ease, background .2s ease;
      }

      .button:hover {
        background: var(--accent-dark);
        transform: translateY(-2px);
      }

      .button.secondary {
        background: transparent;
        color: var(--accent);
      }

      .button.secondary:hover { background: var(--accent-soft); }

      .profile-card {
        padding: 26px;
        border: 1px solid rgba(157, 79, 70, .14);
        border-radius: 22px;
        background: rgba(255, 255, 255, .67);
        box-shadow: var(--shadow);
      }

      .avatar {
        display: grid;
        width: 76px;
        height: 76px;
        margin-bottom: 26px;
        place-items: center;
        border-radius: 22px;
        background: var(--accent);
        color: white;
        font-size: 1.75rem;
        font-weight: 850;
      }

      .profile-card p {
        margin: 0;
        color: var(--muted);
      }

      .profile-card strong {
        display: block;
        margin-bottom: 5px;
        font-size: 1.18rem;
      }

      .quick-facts {
        display: grid;
        gap: 13px;
        margin: 24px 0 0;
        padding: 20px 0 0;
        border-top: 1px solid var(--line);
      }

      .quick-facts span {
        color: var(--teal);
        font-size: .88rem;
        font-weight: 750;
      }

      .about-grid {
        display: grid;
        grid-template-columns: 1.1fr .9fr;
        gap: 56px;
        align-items: start;
        margin-top: 46px;
      }

      .about-copy p {
        margin: 0 0 18px;
        color: #3f4952;
      }

      .value-list {
        display: grid;
        gap: 14px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .value-list li {
        padding: 18px 20px;
        border-left: 3px solid var(--accent);
        border-radius: 0 12px 12px 0;
        background: var(--surface);
        box-shadow: 0 4px 18px rgba(25, 25, 20, .04);
      }

      .value-list strong {
        display: block;
        margin-bottom: 2px;
      }

      .value-list span {
        color: var(--muted);
        font-size: .93rem;
      }

      .skills {
        background: var(--ink);
        color: white;
      }

      .skills .eyebrow { color: #f3b2a7; }
      .skills .section-intro { color: #c8d0d5; }

      .skill-layout {
        display: grid;
        grid-template-columns: 1.15fr .85fr;
        gap: 24px;
        margin-top: 42px;
      }

      .skill-panel {
        padding: 27px;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 18px;
        background: rgba(255,255,255,.045);
      }

      .skill-panel h3 {
        margin: 0 0 16px;
        font-size: 1rem;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
      }

      .tag {
        padding: 7px 11px;
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 100px;
        color: #e7ecee;
        font-size: .86rem;
      }

      .timeline {
        position: relative;
        display: grid;
        gap: 18px;
        margin: 45px 0 0;
      }

      .experience {
        display: grid;
        grid-template-columns: 118px 1fr;
        gap: 28px;
        padding: 25px;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: var(--surface);
        box-shadow: 0 7px 24px rgba(35, 30, 25, .035);
      }

      .experience time {
        color: var(--accent);
        font-size: .86rem;
        font-weight: 800;
      }

      .experience h3 {
        margin: 0;
        font-size: 1.08rem;
      }

      .experience p {
        margin: 9px 0 0;
        color: var(--muted);
      }

      .project {
        margin-top: 44px;
        padding: clamp(26px, 5vw, 54px);
        border-radius: 24px;
        background: linear-gradient(135deg, #f7e4de 0%, #f6efe9 100%);
      }

      .project-grid {
        display: grid;
        grid-template-columns: 1fr .86fr;
        gap: 50px;
        align-items: start;
      }

      .project h3 {
        margin: 0;
        font-size: clamp(1.55rem, 3vw, 2.15rem);
        letter-spacing: -.045em;
      }

      .project p { color: #4f4845; }

      .feature-list {
        display: grid;
        gap: 11px;
        margin: 24px 0 0;
        padding: 0;
        list-style: none;
      }

      .feature-list li::before {
        margin-right: 10px;
        color: var(--accent);
        content: "✓";
        font-weight: 900;
      }

      .learning-card {
        padding: 25px;
        border-radius: 16px;
        background: white;
      }

      .learning-card h4 { margin: 0 0 12px; }
      .learning-card p { margin: 0; }

      footer {
        padding: 44px 0;
        border-top: 1px solid var(--line);
        text-align: center;
      }

      footer p {
        margin: 0;
        color: var(--muted);
        font-size: .92rem;
      }

      footer a {
        color: var(--accent);
        font-weight: 750;
      }

      @media (max-width: 760px) {
        .container { width: min(100% - 32px, 1120px); }
        .nav-links { display: none; }
        .hero { padding: 72px 0 60px; }
        .hero-grid,
        .about-grid,
        .skill-layout,
        .project-grid {
          grid-template-columns: 1fr;
          gap: 32px;
        }

        .section { padding: 65px 0; }
        .experience { grid-template-columns: 1fr; gap: 8px; }
      }
    </style>
  </head>

